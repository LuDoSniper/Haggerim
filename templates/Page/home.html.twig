{% extends 'Layout/base.html.twig' %}

{% block title %}
    Haggerim
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="{{ asset('static/src/css/page/home.css') }}">
    <link rel="stylesheet" href="{{ asset('static/src/css/widget/sidebar.css') }}">
{% endblock %}

{% block main %}
    {% include 'Widget/sidebar.html.twig' %}

    <div id="body">
        <div class="main-title">
            <div class="noir"></div>
            <h1>Bienvenue dans le monde d'<span>Haggerim</span> !</h1>
        </div>

        <div id="features">
            <a href="{{ path('app_member_join') }}">
                <button class="info-bulle member">Rejoindre Haggerim</button>
            </a>
            <button class="info-bulle">Gestion des royaumes</button>
            <button class="info-bulle dev" disabled>Hall of Haggerim's beauties</button>
            <button class="info-bulle">Signaler un joueur</button>
        </div>

        <div id="info-bulle"><span>Ceci est une info bulle</span></div>
    </div>
{% endblock %}

